{
  "id": "io.github.wenhe233.legado",
  "name": "Legado compatibility",
  "description": "Import and read Legado sources through the content plugin API",
  "protocolVersion": 2,
  "pluginVersion": "0.3.0-x1",
  "pluginApi": {
    "min": 4,
    "max": 4
  },
  "entry": "worker.js",
  "permissions": {
    "network": true,
    "storage": true,
    "secrets": true,
    "wasm": true,
    "cookies": true,
    "interaction": true,
    "secretValues": true
  },
  "contributions": {
    "contentSources": [
      {
        "id": "legado",
        "name": "Legado",
        "kinds": [
          "text"
        ],
        "capabilities": {
          "search": true,
          "explore": true,
          "authenticate": true,
          "describe": true
        },
        "settings": []
      }
    ],
    "sourceFormats": [
      {
        "id": "legado",
        "providerId": "legado",
        "name": "Legado source",
        "extensions": [
          "json",
          "txt"
        ]
      }
    ],
    "managementPages": [
      {
        "id": "manage",
        "title": "Legado",
        "providerIds": [
          "legado"
        ],
        "sections": [
          "sourceInstances",
          "sourceSubscriptions",
          "settings",
          "information"
        ]
      }
    ]
  }
}
