{
  "id": "io.github.wenhe233.venera",
  "name": "Venera compatibility",
  "description": "Import and read Venera sources through the content plugin API",
  "protocolVersion": 2,
  "pluginVersion": "0.2.0-x1",
  "pluginApi": {
    "min": 3,
    "max": 3
  },
  "entry": "worker.js",
  "permissions": {
    "network": true,
    "storage": true,
    "secrets": true,
    "wasm": true,
    "cookies": true,
    "interaction": true
  },
  "contributions": {
    "contentSources": [
      {
        "id": "venera",
        "name": "Venera",
        "kinds": ["comic"],
        "capabilities": {
          "search": true,
          "explore": true,
          "authenticate": true
        },
        "settings": []
      }
    ],
    "sourceFormats": [
      {
        "id": "venera",
        "providerId": "venera",
        "name": "Venera source",
        "extensions": ["js"]
      },
      {
        "id": "venera-list",
        "providerId": "venera",
        "name": "Venera source list",
        "extensions": ["json"]
      }
    ]
  }
}
