{
  "id": "io.github.wenhe233.venera",
  "name": "Venera compatibility",
  "description": "Import and read Venera sources through the content plugin API",
  "protocolVersion": 2,
  "pluginVersion": "0.3.0-x1",
  "pluginApi": {
    "min": 4,
    "max": 4
  },
  "entry": "worker.js",
  "permissions": {
    "network": true,
    "storage": true,
    "secrets": true,
    "wasm": true,
    "cookies": true,
    "interaction": true,
    "secretValues": true
  },
  "contributions": {
    "contentSources": [
      {
        "id": "venera",
        "name": "Venera",
        "kinds": [
          "comic"
        ],
        "capabilities": {
          "search": true,
          "explore": true,
          "authenticate": true,
          "describe": true,
          "settingActions": true,
          "validateSettings": true
        },
        "settings": []
      }
    ],
    "sourceFormats": [
      {
        "id": "venera",
        "providerId": "venera",
        "name": "Venera source",
        "extensions": [
          "js"
        ]
      },
      {
        "id": "venera-list",
        "providerId": "venera",
        "name": "Venera source list",
        "extensions": [
          "json"
        ]
      }
    ],
    "managementPages": [
      {
        "id": "manage",
        "title": "Venera",
        "providerIds": [
          "venera"
        ],
        "sections": [
          "sourceInstances",
          "sourceSubscriptions",
          "settings",
          "information"
        ]
      }
    ]
  }
}
